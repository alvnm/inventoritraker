# PostgreSQL: ajusta usuario/contraseña/puerto según tu instalación local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dnd_inventory?schema=public"

# Supabase:
#   DATABASE_URL = Session pooler (puerto 5432) → consultas de la app
#   DIRECT_URL   = Conexión directa (puerto 5432) → migraciones del CLI.
#     ⚠ En producción (Vercel) DIRECT_URL es OBLIGATORIA: si falta, `prisma db push`
#     falla con P1012 ("Environment variable not found: DIRECT_URL").
#     En local puedes usar tu PostgreSQL directo (mismo valor que DATABASE_URL):
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dnd_inventory?schema=public"
# DIRECT_URL="postgresql://postgres:CONTRASEÑA@db.PROYECTO.supabase.co:5432/postgres"
PORT=4000
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_RECOVERY_SECRET="dev-recovery-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
