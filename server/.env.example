# PostgreSQL: ajusta usuario/contraseña/puerto según tu instalación local.
# En Supabase usa el Session pooler (puerto 5432); soporta consultas y también
# migraciones del CLI (db push / migrate), no se necesita DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dnd_inventory?schema=public"
PORT=4000
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_RECOVERY_SECRET="dev-recovery-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
